import React, { useState, useEffect, useCallback } from 'react';
import { Plus, X, Trash2, Pencil, Film, Sparkles } from 'lucide-react';

const STORAGE_KEY = 'premiere:movies';
const FONT_URL =
  "https://fonts.googleapis.com/css2?family=Abril+Fatface&family=Big+Shoulders+Stencil:wght@700;800&family=Work+Sans:wght@400;500;600;700&display=swap";

function daysUntil(dateStr) {
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  const release = new Date(`${dateStr}T00:00:00`);
  return Math.round((release - today) / 86400000);
}

function formatDate(dateStr) {
  const d = new Date(`${dateStr}T00:00:00`);
  return d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
}

function formatAgo(days) {
  const n = Math.abs(days);
  if (n === 0) return 'Released today';
  if (n === 1) return 'Released yesterday';
  if (n < 7) return `Released ${n} days ago`;
  if (n < 30) {
    const w = Math.round(n / 7);
    return `Released ${w} week${w > 1 ? 's' : ''} ago`;
  }
  if (n < 365) {
    const m = Math.round(n / 30);
    return `Released ${m} month${m > 1 ? 's' : ''} ago`;
  }
  const y = Math.round(n / 365);
  return `Released ${y} year${y > 1 ? 's' : ''} ago`;
}

function Poster({ url, alt, errored, onError }) {
  if (!url || errored) {
    return (
      <div className="pm-poster-frame rounded-lg w-full flex items-center justify-center">
        <Film className="w-1/4 h-1/4" style={{ color: 'rgba(232,184,75,0.3)' }} strokeWidth={1.5} />
      </div>
    );
  }
  return (
    <img
      src={url}
      alt={alt}
      onError={onError}
      className="pm-poster-frame rounded-lg w-full object-cover"
    />
  );
}

function CountdownDial({ days, size }) {
  const isLg = size === 'lg';
  let label;
  if (days <= 0) label = isLg ? 'TODAY' : 'NOW';
  else if (days === 1) label = isLg ? 'TOMORROW' : '1D';
  else label = isLg ? String(days) : `${days}D`;
  const showUnit = isLg && days > 1;

  return (
    <div className={`pm-dial-outer ${isLg ? 'pm-dial-lg' : 'pm-dial-sm'}`}>
      <div className="pm-dial-inner" style={{ width: '78%', height: '78%' }}>
        <span className={`pm-stencil pm-gold-text leading-none font-extrabold ${isLg ? 'pm-dial-num-lg' : 'text-xs'}`}>
          {label}
        </span>
        {showUnit && (
          <span className="pm-body tracking-widest mt-1" style={{ color: '#C9A227', fontSize: 10 }}>
            DAYS TO GO
          </span>
        )}
      </div>
    </div>
  );
}

function MovieCard({ movie, days, released, errored, onImgError, onEdit, onDelete, confirming }) {
  return (
    <div>
      <div className="relative">
        <Poster url={movie.posterUrl} alt={movie.title} errored={errored} onError={onImgError} />
        {!released && (
          <div className="absolute -top-2 -right-2">
            <CountdownDial days={days} size="sm" />
          </div>
        )}
        <div className="absolute top-1.5 left-1.5 flex gap-1">
          <button
            onClick={onEdit}
            aria-label="Edit movie"
            className="pm-icon-btn rounded-full w-6 h-6 flex items-center justify-center"
          >
            <Pencil className="w-3 h-3" style={{ color: '#F1E7D0' }} />
          </button>
          <button
            onClick={onDelete}
            aria-label={confirming ? 'Confirm remove movie' : 'Remove movie'}
            className="pm-icon-btn rounded-full h-6 px-1.5 flex items-center justify-center"
            style={{ backgroundColor: confirming ? '#9C2E3D' : undefined }}
          >
            <Trash2 className="w-3 h-3" style={{ color: '#F1E7D0' }} />
            {confirming && <span className="pm-body ml-1 text-xs" style={{ color: '#F1E7D0' }}>Sure?</span>}
          </button>
        </div>
      </div>
      <p className="pm-body mt-2 text-sm font-semibold truncate" style={{ color: '#F1E7D0' }}>{movie.title}</p>
      <p className="pm-body pm-ash text-xs">{released ? formatAgo(days) : formatDate(movie.releaseDate)}</p>
    </div>
  );
}

function MovieForm({ form, setForm, editingId, onCancel, onSubmit }) {
  const submitOnEnter = (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      onSubmit();
    }
  };

  return (
    <div className="pm-modal-backdrop fixed inset-0 flex items-center justify-center p-4 z-50" onClick={onCancel}>
      <div
        className="pm-panel-bg w-full max-w-md rounded-2xl p-6 overflow-y-auto"
        style={{ maxHeight: '88vh', border: '1px solid rgba(241,231,208,0.1)' }}
        onClick={(e) => e.stopPropagation()}
      >
        <div className="flex items-center justify-between mb-5">
          <h3 className="pm-display text-2xl" style={{ color: '#F1E7D0' }}>
            {editingId ? 'Edit Movie' : 'Add Movie'}
          </h3>
          <button onClick={onCancel} aria-label="Close">
            <X className="w-5 h-5 pm-ash" />
          </button>
        </div>

        <div className="space-y-4">
          <div>
            <label className="pm-body pm-ash text-xs uppercase tracking-widest block mb-1.5">Title</label>
            <input
              type="text"
              value={form.title}
              onChange={(e) => setForm({ ...form, title: e.target.value })}
              onKeyDown={submitOnEnter}
              placeholder="e.g. Dune: Part Three"
              className="pm-field pm-body w-full rounded-lg px-3 py-2 text-sm"
            />
          </div>
          <div>
            <label className="pm-body pm-ash text-xs uppercase tracking-widest block mb-1.5">Release Date</label>
            <input
              type="date"
              value={form.releaseDate}
              onChange={(e) => setForm({ ...form, releaseDate: e.target.value })}
              onKeyDown={submitOnEnter}
              className="pm-field pm-body w-full rounded-lg px-3 py-2 text-sm"
              style={{ colorScheme: 'dark' }}
            />
          </div>
          <div>
            <label className="pm-body pm-ash text-xs uppercase tracking-widest block mb-1.5">Poster Image URL</label>
            <input
              type="text"
              value={form.posterUrl}
              onChange={(e) => setForm({ ...form, posterUrl: e.target.value })}
              onKeyDown={submitOnEnter}
              placeholder="https://…"
              className="pm-field pm-body w-full rounded-lg px-3 py-2 text-sm"
            />
            {form.posterUrl && (
              <div className="pm-poster-frame rounded-lg overflow-hidden mt-2" style={{ width: 72 }}>
                <img
                  src={form.posterUrl}
                  alt="Preview"
                  className="w-full h-full object-cover"
                  onError={(e) => { e.target.style.display = 'none'; }}
                />
              </div>
            )}
          </div>
          <div>
            <label className="pm-body pm-ash text-xs uppercase tracking-widest block mb-1.5">Notes</label>
            <textarea
              value={form.notes}
              onChange={(e) => setForm({ ...form, notes: e.target.value })}
              placeholder="Genre, who you're seeing it with, why you're hyped…"
              rows={2}
              className="pm-field pm-body w-full rounded-lg px-3 py-2 text-sm resize-none"
            />
          </div>
        </div>

        <div className="flex gap-3 mt-6">
          <button onClick={onCancel} className="pm-btn-ghost pm-body flex-1 rounded-full py-2.5 text-sm font-medium">
            Cancel
          </button>
          <button
            onClick={onSubmit}
            disabled={!form.title.trim() || !form.releaseDate}
            className="pm-btn-gold pm-body flex-1 rounded-full py-2.5 text-sm font-semibold"
          >
            {editingId ? 'Save Changes' : 'Add Movie'}
          </button>
        </div>
      </div>
    </div>
  );
}

export default function MovieCountdownTracker() {
  const [movies, setMovies] = useState([]);
  const [ready, setReady] = useState(false);
  const [saveIssue, setSaveIssue] = useState(false);
  const [showForm, setShowForm] = useState(false);
  const [editingId, setEditingId] = useState(null);
  const [form, setForm] = useState({ title: '', releaseDate: '', posterUrl: '', notes: '' });
  const [imgErrors, setImgErrors] = useState({});
  const [confirmDeleteId, setConfirmDeleteId] = useState(null);

  useEffect(() => {
    let cancelled = false;
    (async () => {
      try {
        const res = await window.storage.get(STORAGE_KEY, false);
        if (!cancelled && res && res.value) setMovies(JSON.parse(res.value));
      } catch (e) {
        // nothing saved yet
      } finally {
        if (!cancelled) setReady(true);
      }
    })();
    return () => { cancelled = true; };
  }, []);

  const persist = useCallback(async (list) => {
    setMovies(list);
    try {
      const res = await window.storage.set(STORAGE_KEY, JSON.stringify(list), false);
      setSaveIssue(!res);
    } catch (e) {
      setSaveIssue(true);
    }
  }, []);

  const openAdd = () => {
    setForm({ title: '', releaseDate: '', posterUrl: '', notes: '' });
    setEditingId(null);
    setShowForm(true);
  };

  const openEdit = (movie) => {
    setForm({ title: movie.title, releaseDate: movie.releaseDate, posterUrl: movie.posterUrl || '', notes: movie.notes || '' });
    setEditingId(movie.id);
    setConfirmDeleteId(null);
    setShowForm(true);
  };

  const closeForm = () => {
    setShowForm(false);
    setEditingId(null);
  };

  const submitForm = () => {
    if (!form.title.trim() || !form.releaseDate) return;
    const cleaned = {
      title: form.title.trim(),
      releaseDate: form.releaseDate,
      posterUrl: form.posterUrl.trim(),
      notes: form.notes.trim(),
    };
    if (editingId) {
      persist(movies.map((m) => (m.id === editingId ? { ...m, ...cleaned } : m)));
    } else {
      persist([...movies, { id: `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`, ...cleaned }]);
    }
    closeForm();
  };

  const requestDelete = (id) => {
    if (confirmDeleteId === id) {
      persist(movies.filter((m) => m.id !== id));
      setConfirmDeleteId(null);
    } else {
      setConfirmDeleteId(id);
    }
  };

  const upcoming = movies
    .filter((m) => daysUntil(m.releaseDate) >= 0)
    .sort((a, b) => daysUntil(a.releaseDate) - daysUntil(b.releaseDate));
  const released = movies
    .filter((m) => daysUntil(m.releaseDate) < 0)
    .sort((a, b) => daysUntil(b.releaseDate) - daysUntil(a.releaseDate));
  const hero = upcoming[0];
  const restUpcoming = upcoming.slice(1);
  const heroDays = hero ? daysUntil(hero.releaseDate) : 0;

  return (
    <div className="pm-root pm-body min-h-screen">
      <style>{`
        @import url('${FONT_URL}');
        .pm-root { background: radial-gradient(ellipse 120% 60% at 50% 0%, #1B1518 0%, #100C0E 65%); color: #F1E7D0; }
        .pm-display { font-family: 'Abril Fatface', serif; }
        .pm-stencil { font-family: 'Big Shoulders Stencil', sans-serif; }
        .pm-body { font-family: 'Work Sans', sans-serif; }
        .pm-ash { color: #9C9691; }
        .pm-gold-text { color: #E8B84B; }
        .pm-btn-gold { background-color: #E8B84B; color: #100C0E; transition: background-color 0.15s ease; }
        .pm-btn-gold:hover { background-color: #F2C766; }
        .pm-btn-gold:disabled { background-color: rgba(241,231,208,0.08); color: #6b6663; cursor: not-allowed; }
        .pm-btn-ghost { background-color: transparent; color: #F1E7D0; border: 1px solid rgba(241,231,208,0.18); transition: background-color 0.15s ease; }
        .pm-btn-ghost:hover { background-color: rgba(241,231,208,0.07); }
        .pm-field { background-color: rgba(241,231,208,0.05); border: 1px solid rgba(241,231,208,0.15); color: #F1E7D0; }
        .pm-field:focus { outline: 2px solid rgba(232,184,75,0.45); outline-offset: 1px; border-color: #E8B84B; }
        .pm-field::placeholder { color: #716C67; }
        .pm-panel-bg { background-color: #1B1518; }
        .pm-poster-frame { border: 1px solid rgba(232,184,75,0.15); aspect-ratio: 2 / 3; }
        .pm-icon-btn { background-color: rgba(16,12,14,0.75); border: 1px solid rgba(241,231,208,0.15); transition: background-color 0.15s ease; }
        .pm-icon-btn:hover { background-color: rgba(16,12,14,0.95); }
        .pm-dial-outer { border-radius: 9999px; border-style: dashed; border-color: #E8B84B; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
        .pm-dial-inner { border-radius: 9999px; background-color: #100C0E; border: 1px solid rgba(232,184,75,0.3); display: flex; flex-direction: column; align-items: center; justify-content: center; }
        .pm-dial-lg { width: clamp(108px, 24vw, 148px); height: clamp(108px, 24vw, 148px); border-width: 4px; }
        .pm-dial-sm { width: 46px; height: 46px; border-width: 3px; }
        .pm-dial-num-lg { font-size: clamp(26px, 6vw, 38px); }
        .pm-hero-divider { border-top: 2px dashed rgba(232,184,75,0.35); padding-top: 1.25rem; }
        @media (min-width: 640px) {
          .pm-hero-divider { border-top: none; border-left: 2px dashed rgba(232,184,75,0.35); padding-top: 0; padding-left: 2.5rem; }
        }
        .pm-perf { border: none; border-top: 2px dashed rgba(232,184,75,0.22); margin: 2.5rem 0 1.25rem; }
        .pm-modal-backdrop { background-color: rgba(16,12,14,0.85); backdrop-filter: blur(4px); }
        .pm-wordmark { font-size: clamp(24px, 5vw, 32px); }
        .pm-hero-title { font-size: clamp(22px, 4.5vw, 34px); line-height: 1.15; }
        @media (prefers-reduced-motion: reduce) {
          .pm-root * { transition-duration: 0.01ms !important; }
        }
      `}</style>

      <div className="max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-10">
        <div className="flex items-center justify-between mb-8">
          <div className="flex items-center gap-2">
            <Film className="w-6 h-6" style={{ color: '#E8B84B' }} />
            <h1 className="pm-display pm-wordmark" style={{ color: '#F1E7D0' }}>Premiere</h1>
          </div>
          <button onClick={openAdd} className="pm-btn-gold pm-body flex items-center gap-1.5 rounded-full px-4 py-2 text-sm font-semibold">
            <Plus className="w-4 h-4" strokeWidth={2.5} />
            Add Movie
          </button>
        </div>

        {saveIssue && (
          <div className="pm-body text-xs mb-6 rounded-lg px-3 py-2" style={{ color: '#F1E7D0', backgroundColor: 'rgba(156,46,61,0.25)', border: '1px solid rgba(156,46,61,0.5)' }}>
            Changes aren't saving right now — keep this tab open so you don't lose anything.
          </div>
        )}

        {!ready ? (
          <div className="pm-body pm-ash text-center py-24">Loading your watchlist…</div>
        ) : movies.length === 0 ? (
          <div className="text-center py-20 rounded-3xl" style={{ border: '1px dashed rgba(232,184,75,0.3)' }}>
            <Sparkles className="w-8 h-8 mx-auto mb-4" style={{ color: 'rgba(232,184,75,0.6)' }} />
            <p className="pm-display text-2xl" style={{ color: '#F1E7D0' }}>No movies yet</p>
            <p className="pm-body pm-ash mt-2 mb-6">Add the next release you can't stop thinking about.</p>
            <button onClick={openAdd} className="pm-btn-gold pm-body inline-flex items-center gap-1.5 rounded-full px-5 py-2.5 text-sm font-semibold">
              <Plus className="w-4 h-4" strokeWidth={2.5} />
              Add a movie
            </button>
          </div>
        ) : (
          <>
            {hero && (
              <div className="relative rounded-2xl overflow-hidden">
                <div className="absolute inset-0">
                  {hero.posterUrl && !imgErrors[hero.id] ? (
                    <img src={hero.posterUrl} alt="" className="w-full h-full object-cover blur-2xl scale-110 opacity-40" />
                  ) : (
                    <div className="w-full h-full pm-panel-bg" />
                  )}
                  <div className="absolute inset-0" style={{ background: 'linear-gradient(to top, #100C0E 15%, rgba(16,12,14,0.88) 55%, rgba(16,12,14,0.55) 100%)' }} />
                </div>
                <div className="relative flex flex-col sm:flex-row items-center gap-6 p-6 sm:p-9">
                  <div className="flex flex-col sm:flex-row items-center gap-5 shrink-0">
                    <div style={{ width: 'clamp(92px, 22vw, 128px)' }}>
                      <Poster url={hero.posterUrl} alt={hero.title} errored={imgErrors[hero.id]} onError={() => setImgErrors((e) => ({ ...e, [hero.id]: true }))} />
                    </div>
                    <CountdownDial days={heroDays} size="lg" />
                  </div>
                  <div className="pm-hero-divider text-center sm:text-left w-full sm:flex-1">
                    <p className="pm-body pm-gold-text text-xs uppercase tracking-widest font-semibold mb-2">Up Next</p>
                    <h2 className="pm-display pm-hero-title" style={{ color: '#F1E7D0' }}>{hero.title}</h2>
                    <p className="pm-body pm-ash text-sm mt-1.5">{formatDate(hero.releaseDate)}</p>
                    {hero.notes && (
                      <p className="pm-body text-sm mt-3 mx-auto sm:mx-0" style={{ color: 'rgba(241,231,208,0.7)', maxWidth: 440 }}>
                        {hero.notes}
                      </p>
                    )}
                    <div className="flex items-center gap-4 justify-center sm:justify-start mt-4">
                      <button onClick={() => openEdit(hero)} className="pm-body pm-ash flex items-center gap-1 text-xs">
                        <Pencil className="w-3.5 h-3.5" /> Edit
                      </button>
                      <button
                        onClick={() => requestDelete(hero.id)}
                        className="pm-body flex items-center gap-1 text-xs"
                        style={{ color: confirmDeleteId === hero.id ? '#E8828F' : '#9C9691', fontWeight: confirmDeleteId === hero.id ? 600 : 400 }}
                      >
                        <Trash2 className="w-3.5 h-3.5" /> {confirmDeleteId === hero.id ? 'Tap again to remove' : 'Remove'}
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            )}

            {restUpcoming.length > 0 && (
              <>
                <hr className="pm-perf" />
                <p className="pm-body pm-gold-text text-xs uppercase tracking-widest font-semibold mb-4">Coming Soon</p>
                <div className="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-x-4 gap-y-6">
                  {restUpcoming.map((m) => (
                    <MovieCard
                      key={m.id}
                      movie={m}
                      days={daysUntil(m.releaseDate)}
                      errored={imgErrors[m.id]}
                      onImgError={() => setImgErrors((e) => ({ ...e, [m.id]: true }))}
                      onEdit={() => openEdit(m)}
                      onDelete={() => requestDelete(m.id)}
                      confirming={confirmDeleteId === m.id}
                    />
                  ))}
                </div>
              </>
            )}

            {released.length > 0 && (
              <>
                {hero && <hr className="pm-perf" />}
                <p className="pm-body text-xs uppercase tracking-widest font-semibold mb-4" style={{ color: '#716C67' }}>Now Showing</p>
                <div className="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-x-4 gap-y-6 opacity-60">
                  {released.map((m) => (
                    <MovieCard
                      key={m.id}
                      movie={m}
                      days={daysUntil(m.releaseDate)}
                      released
                      errored={imgErrors[m.id]}
                      onImgError={() => setImgErrors((e) => ({ ...e, [m.id]: true }))}
                      onEdit={() => openEdit(m)}
                      onDelete={() => requestDelete(m.id)}
                      confirming={confirmDeleteId === m.id}
                    />
                  ))}
                </div>
              </>
            )}
          </>
        )}
      </div>

      {showForm && <MovieForm form={form} setForm={setForm} editingId={editingId} onCancel={closeForm} onSubmit={submitForm} />}
    </div>
  );
}
